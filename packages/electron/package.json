    "decomment": "^0.9.5",
    "diff": "^8.0.3",
    "dotenv": "^16.0.3",
    "electron-is-dev": "^2.0.0",
    "electron-store": "^8.1.0",
    "electron-util": "^0.17.2",
    "express": "4.22.3",
    "form-data": "4.0.6",
    "fs-extra": "^10.1.0",
    "graphql": "^16.6.0",

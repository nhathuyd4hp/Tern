    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.6"
  },
  "scripts": {
    "setup": "node ./scripts/setup.js",
    "watch:converters": "npm run watch --workspace=packages/converters",
    "dev": "node ./scripts/dev.js",
    "watch": "npm run dev:watch",
    "dev:watch": "node ./scripts/dev-hot-reload.js",
    "dev:web": "npm run dev --workspace=packages/app",
    "build:web": "npm run build --workspace=packages/app",
    "dev:electron": "npm run dev --workspace=packages/electron",
    "dev:electron:debug": "npm run debug --workspace=packages/electron",
    "build:common": "npm run build --workspace=packages/common",
    "build:requests": "npm run build --workspace=packages/requests",
    "build:filestore": "npm run build --workspace=packages/filestore",
    "build:sqlite": "npm run build --workspace=packages/sqlite",
    "build:converters": "npm run build --workspace=packages/converters",
    "build:query": "npm run build --workspace=packages/query",
    "build:graphql-docs": "npm run build --workspace=packages/graphql-docs",
    "build:schema-types": "npm run build --workspace=packages/schema-types",
    "generate:script-api": "npm run generate:script-api --workspace=packages/js",
    "build:electron": "node ./scripts/build-electron.js",
    "build:electron:mac": "./scripts/build-electron.sh mac",
    "build:electron:win": "./scripts/build-electron.sh win",
    "build:electron:linux": "./scripts/build-electron.sh linux",
    "build:electron:deb": "./scripts/build-electron.sh deb",
    "build:electron:rpm": "./scripts/build-electron.sh rpm",
    "build:electron:snap": "./scripts/build-electron.sh snap",
    "watch:common": "npm run watch --workspace=packages/common",
    "watch:requests": "npm run watch --workspace=packages/requests",
    "lint": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" npx eslint",
    "lint:fix": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" npx eslint --fix",
    "prepare": "husky",
    "version:bump": "npx lerna version --no-private --exact --dry-run",
    "version:since:last": "npx lerna publish from-package --dry-run"
  },
  "nano-staged": {
    "*.{js,ts,jsx}": [
      "npm run lint:fix"
    ]
  },
  "overrides": {
    "axios": "1.21.0",
    "tar": "7.5.22",
    "app-builder-lib": {
      "tar": "7.5.22"
    },
    "@mapbox/node-pre-gyp": {
      "tar": "7.5.22"
    },
    "brace-expansion@5": "5.0.12",
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    },
    "rollup": "3.30.0",
    "pbkdf2": "3.1.7",
    "@prantlf/jsonlint": {
      "ajv": "8.18.0",
      "diff": "5.2.2"
    },
    "swagger-ui-react": {
      "js-yaml": "4.3.2"
    },
    "httpsnippet": {
      "form-data": "4.0.6"
    },
    "jshint": {
      "lodash": "4.18.1",
      "minimatch": "3.1.5"
    },
    "electron-store": {
      "conf": {
        "json-schema-typed": "8.0.1"
      }
    }
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "git-url-parse": "^14.1.0"
  }

    "@lerna-lite/version": "^4.11.2",
    "@rollup/plugin-json": "^6.1.0",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.39.0",
    "adm-zip": "0.6.1",
    "concurrently": "^8.2.2",
    "cross-env": "10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-diff": "^2.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
